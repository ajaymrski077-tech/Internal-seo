// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Client {
  id             Int                 @id @default(autoincrement())
  name           String
  companyName    String?
  logoUrl        String?
  status         String              @default("ACTIVE") // ACTIVE, ONBOARDING, PAUSED, ARCHIVED
  isArchived     Boolean             @default(false)
  shareToken     String?             @unique
  managerName    String?
  notes          String?
  startDate      DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  properties     WebsiteProperty[]
  deliveryEvents DeliveryEvent[]
  reports        Report[]
  tickets        Ticket[]
  tasks          Task[]
  prCampaigns    PrCampaign[]
  linkCampaigns  LinkCampaign[]
  trackedKeywords TrackedKeyword[]
}

model WebsiteProperty {
  id             Int                 @id @default(autoincrement())
  clientId       Int
  client         Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  domain         String
  name           String
  brandType      String              @default("Non-Branded")
  brandKeywords  String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  snapshots      AnalyticsSnapshot[]
  connections    IntegrationConnection[]
  deliveryEvents DeliveryEvent[]
  reports        Report[]
  trackedKeywords TrackedKeyword[]
  seoAudits      SeoAudit[]
  gbpLocation    GbpLocation?
  contentItems   ContentItem[]
}

model IntegrationConnection {
  id                  Int             @id @default(autoincrement())
  propertyId          Int
  property            WebsiteProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  provider            String          // GA4, GSC, GBP
  status              String          // CONNECTED, SYNC_ERROR, DISCONNECTED
  syncStatus          String?         // SUCCESS, FAILED
  syncError           String?
  lastSyncTime        DateTime?
  accessToken         String?
  refreshToken        String?
  tokenExpiry         DateTime?
  externalId          String?         // GA4 Property ID, GSC Site URL, or GBP Location ID
  conversionEventName String?         // GA4 conversion event definition
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  gbpLocations        GbpLocation[]

  @@unique([propertyId, provider])
  @@index([propertyId])
}

model AnalyticsSnapshot {
  id             Int             @id @default(autoincrement())
  propertyId     Int
  property       WebsiteProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date           DateTime
  sessions       Int
  organicTraffic Int
  conversions    Int
  gscImpressions Int             @default(0)
  gscPosition    Float           @default(0.0)
  createdAt      DateTime        @default(now())

  @@unique([propertyId, date])
  @@index([propertyId])
  @@index([date])
}

model DeliveryEvent {
  id             Int              @id @default(autoincrement())
  clientId       Int
  client         Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId     Int?
  property       WebsiteProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  type           String           // BACKLINK, CONTENT, MILESTONE
  date           DateTime
  description    String
  createdAt      DateTime         @default(now())
  contentDetails ContentDelivery?
  linkDetails    LinkDelivery?

  @@index([clientId])
  @@index([propertyId])
  @@index([date])
}

model ContentDelivery {
  id              Int           @id @default(autoincrement())
  deliveryEventId Int           @unique
  deliveryEvent   DeliveryEvent @relation(fields: [deliveryEventId], references: [id], onDelete: Cascade)
  title           String
  url             String
  wordCount       Int
}

model LinkDelivery {
  id              Int           @id @default(autoincrement())
  deliveryEventId Int           @unique
  deliveryEvent   DeliveryEvent @relation(fields: [deliveryEventId], references: [id], onDelete: Cascade)
  url             String
  anchorText      String
  targetUrl       String
  domainAuthority Int
}

model ActivityLog {
  id          Int      @id @default(autoincrement())
  actorEmail  String   @default("admin@mistersk.com")
  action      String   // CLIENT_CREATED, CLIENT_UPDATED, CLIENT_ARCHIVED, CLIENT_RESTORED, WEBSITE_CHANGED, INTEGRATION_CONNECTED, INTEGRATION_DISCONNECTED, SHARE_LINK_REGENERATED
  clientId    Int?
  clientName  String?
  metadata    String?  // JSON string
  createdAt   DateTime @default(now())
}

model Report {
  id              Int              @id @default(autoincrement())
  clientId        Int
  client          Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId      Int?
  property        WebsiteProperty? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  name            String
  dateRange       String           // "7d", "30d", "90d", "1y", "custom"
  startDate       DateTime
  endDate         DateTime
  comparisonRange String           // "PREV_PERIOD", "PREV_YEAR", "NONE"
  status          String           @default("DRAFT") // DRAFT, GENERATING, READY, FAILED, ARCHIVED
  sections        String           // JSON array, e.g. '["overview","sessions","organic","conversions","deliveries"]'
  shareToken      String?          @unique
  isArchived      Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  snapshots       ReportSnapshot[]

  @@index([clientId])
  @@index([propertyId])
}

model ReportSnapshot {
  id             Int      @id @default(autoincrement())
  reportId       Int
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  metricsJson    String   // JSON string of metrics
  historyJson    String   // JSON string of current/previous period history
  deliveriesJson String   // JSON string of delivery events
  rankingsJson   String?  // JSON string of tracked keyword rankings snapshot
  generatedAt    DateTime @default(now())

  @@index([reportId])
}

model Ticket {
  id          Int      @id @default(autoincrement())
  subject     String
  clientId    Int
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  fromName    String
  status      String   @default("open") // in progress, pending, open, closed
  priority    String   @default("normal") // low, normal, high, urgent
  assignedTo  String?  @default("—")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Task {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  status      String    @default("TODO") // TODO, IN_PROGRESS, DONE
  priority    String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  assignedTo  String?   @default("—")
  clientId    Int?
  client       Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  dueDate      DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  prCampaignId   Int?
  prCampaign     PrCampaign? @relation(fields: [prCampaignId], references: [id], onDelete: SetNull)
  linkCampaignId Int?
  linkCampaign   LinkCampaign? @relation(fields: [linkCampaignId], references: [id], onDelete: SetNull)

  @@index([clientId])
  @@index([prCampaignId])
  @@index([linkCampaignId])
}

model PrCampaign {
  id              Int                @id @default(autoincrement())
  clientId        Int
  client          Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaignName    String
  description     String?
  objective       String?
  status          String             @default("DRAFT") // DRAFT, PLANNING, ACTIVE, PAUSED, COMPLETED, CANCELLED
  priority        String             @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  startDate       DateTime?
  targetDate      DateTime?
  completedDate   DateTime?
  budget          Float?
  outreachRecords PrOutreachRecord[]
  placements      PrPlacement[]
  tasks           Task[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([clientId])
}

model PrPublication {
  id              Int                  @id @default(autoincrement())
  name            String
  website         String
  domain          String
  domainAuthority Int?
  category        String?
  country         String?
  notes           String?
  contacts        PrContact[]
  outreachRecords PrOutreachRecord[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model PrContact {
  id              Int                  @id @default(autoincrement())
  name            String
  email           String?
  role            String?
  publicationId   Int?
  publication     PrPublication?       @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  website         String?
  notes           String?
  outreachRecords PrOutreachRecord[]
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([publicationId])
}

model PrOutreachRecord {
  id              Int            @id @default(autoincrement())
  campaignId      Int
  campaign        PrCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  publicationId   Int?
  publication     PrPublication? @relation(fields: [publicationId], references: [id], onDelete: SetNull)
  contactId       Int?
  contact         PrContact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  contactName     String
  contactEmail    String?
  publicationName String
  targetUrl       String?
  outreachStatus  String         @default("NOT_CONTACTED") // NOT_CONTACTED, CONTACTED, FOLLOW_UP, RESPONDED, INTERESTED, REJECTED, PUBLISHED, LOST
  sentAt          DateTime?
  followUpDate    DateTime?
  respondedAt     DateTime?
  notes           String?
  placements      PrPlacement[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([campaignId])
  @@index([publicationId])
  @@index([contactId])
}

model PrPlacement {
  id              Int               @id @default(autoincrement())
  campaignId      Int
  campaign        PrCampaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  outreachId      Int?
  outreachRecord  PrOutreachRecord? @relation(fields: [outreachId], references: [id], onDelete: SetNull)
  publicationName String
  publicationUrl  String?
  articleTitle    String
  articleUrl      String
  publishedDate   DateTime?
  targetUrl       String?
  linkType        String            @default("UNKNOWN") // FOLLOW, NOFOLLOW, MENTION_ONLY, UNKNOWN
  notes           String?
  verifiedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([campaignId])
  @@index([outreachId])
}

model LinkCampaign {
  id             Int               @id @default(autoincrement())
  clientId       Int
  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  objective      String?
  status         String            @default("DRAFT") // DRAFT, ACTIVE, PAUSED, COMPLETED, CANCELLED
  priority       String            @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  startDate      DateTime?
  targetDate     DateTime?
  completedDate  DateTime?
  monthlyTarget  Int?
  opportunities  LinkOpportunity[]
  acquiredLinks  AcquiredBacklink[]
  tasks          Task[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([clientId])
}

model LinkOpportunity {
  id                 Int                @id @default(autoincrement())
  campaignId         Int
  campaign           LinkCampaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  domain             String
  websiteName        String
  websiteUrl         String
  contactName        String?
  contactEmail       String?
  sourceType         String             @default("MANUAL") // MANUAL, PR_OUTREACH, GUEST_POST, RESOURCE_PAGE, BROKEN_LINK, PARTNERSHIP, DIRECTORY, COMPETITOR_RESEARCH, OTHER
  relevance          String?
  authorityMetric    Int?
  authoritySource    String             @default("MANUAL")
  targetPage         String?
  proposedAnchorText String?
  status             String             @default("PROSPECT") // PROSPECT, QUALIFIED, CONTACTED, FOLLOW_UP, NEGOTIATING, APPROVED, REJECTED, ACQUIRED, LOST
  notes              String?
  discoveredAt       DateTime           @default(now())
  contactedAt        DateTime?
  lastContactAt      DateTime?
  followUpDate       DateTime?
  acquiredLinks      AcquiredBacklink[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([campaignId])
}

model AcquiredBacklink {
  id              Int              @id @default(autoincrement())
  campaignId      Int
  campaign        LinkCampaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  opportunityId   Int?
  opportunity     LinkOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  sourceDomain    String
  sourceUrl       String
  targetUrl       String
  anchorText      String
  linkType        String           @default("UNKNOWN") // FOLLOW, NOFOLLOW, SPONSORED, UGC, UNKNOWN
  status          String           @default("PENDING_VERIFICATION") // PENDING_VERIFICATION, LIVE, MISSING, BROKEN, REDIRECTED, NOFOLLOW_CHANGED, UNKNOWN
  acquiredDate    DateTime         @default(now())
  firstVerifiedAt DateTime?
  lastCheckedAt   DateTime?
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([campaignId])
  @@index([opportunityId])
}

model TrackedKeyword {
  id                Int                      @id @default(autoincrement())
  clientId          Int
  client            Client                   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  propertyId        Int
  property          WebsiteProperty          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  keyword           String
  normalizedKeyword String
  status            String                   @default("ACTIVE") // ACTIVE, PAUSED, ARCHIVED
  tags              String                   @default("")
  targetUrl         String?
  source            String                   @default("MANUAL") // GSC_DISCOVERED, MANUAL, IMPORTED
  snapshots         KeywordRankingSnapshot[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([propertyId, normalizedKeyword])
  @@index([clientId])
  @@index([propertyId])
}

model KeywordRankingSnapshot {
  id               Int            @id @default(autoincrement())
  trackedKeywordId Int
  trackedKeyword   TrackedKeyword @relation(fields: [trackedKeywordId], references: [id], onDelete: Cascade)
  date             DateTime
  position         Float?
  clicks           Int            @default(0)
  impressions      Int            @default(0)
  ctr              Float          @default(0.0)
  createdAt        DateTime       @default(now())

  @@unique([trackedKeywordId, date])
  @@index([trackedKeywordId])
}

model SeoAudit {
  id              Int        @id @default(autoincrement())
  propertyId      Int
  property        WebsiteProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  status          String     @default("QUEUED") // QUEUED, RUNNING, COMPLETED, FAILED, CANCELLED
  score           Float?
  pagesDiscovered Int        @default(0)
  pagesCrawled    Int        @default(0)
  issuesCritical  Int        @default(0)
  issuesHigh      Int        @default(0)
  issuesMedium    Int        @default(0)
  issuesLow       Int        @default(0)
  issuesInfo      Int        @default(0)
  configuration   String     @default("{}") // JSON: maxPages, maxDepth, concurrency, respectRobots, etc.
  errorMessage    String?
  startTime       DateTime?
  endTime         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  pages           SeoPage[]
  issues          SeoIssue[]

  @@index([propertyId])
}

model SeoPage {
  id              Int        @id @default(autoincrement())
  auditId         Int
  audit           SeoAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  url             String
  normalizedUrl   String
  statusCode      Int?
  finalUrl        String?
  contentType     String?
  responseMs      Int?
  htmlSize        Int?
  wordCount       Int?
  title           String?
  titleLength     Int?
  metaDescription String?
  metaDescLength  Int?
  h1              String?
  h1Count         Int        @default(0)
  h2Count         Int        @default(0)
  h3Count         Int        @default(0)
  canonical       String?
  canonicalIsValid Boolean?
  robotsMeta      String?
  isNoindex       Boolean    @default(false)
  isNofollow      Boolean    @default(false)
  internalLinks   Int        @default(0)
  externalLinks   Int        @default(0)
  imageCount      Int        @default(0)
  missingAltCount Int        @default(0)
  isIndexable     Boolean    @default(true)
  depth           Int        @default(0)
  redirectChain   String?    // JSON array of redirect URLs
  createdAt       DateTime   @default(now())
  issues          SeoIssue[]

  @@unique([auditId, normalizedUrl])
  @@index([auditId])
}

model SeoIssue {
  id              Int        @id @default(autoincrement())
  auditId         Int
  audit           SeoAudit   @relation(fields: [auditId], references: [id], onDelete: Cascade)
  pageId          Int?
  page            SeoPage?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type            String     // MISSING_TITLE, DUPLICATE_TITLE, TITLE_TOO_LONG, etc.
  severity        String     // CRITICAL, HIGH, MEDIUM, LOW, INFO
  description     String
  recommendation  String?
  url             String?
  createdAt       DateTime   @default(now())

  @@index([auditId])
  @@index([pageId])
  @@index([type])
  @@index([severity])
}

model GbpLocation {
  id              Int              @id @default(autoincrement())
  propertyId      Int              @unique
  property        WebsiteProperty  @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  connectionId    Int
  connection      IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  locationName    String           // e.g. locations/123456
  accountName     String           // e.g. accounts/987654
  displayName     String           // Business name
  primaryCategory String?
  address         String?
  phone           String?
  websiteUri      String?
  syncStatus      String           @default("CONNECTED") // CONNECTED, DISCONNECTED, EXPIRED, ERROR, SYNCING
  syncError       String?
  lastSyncTime    DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  snapshots       GbpPerformanceSnapshot[]

  @@index([connectionId])
}

model GbpPerformanceSnapshot {
  id               Int         @id @default(autoincrement())
  locationId       Int
  location         GbpLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)
  date             DateTime
  viewsSearch      Int         @default(0)
  viewsMaps        Int         @default(0)
  clicksWebsite    Int         @default(0)
  clicksCall       Int         @default(0)
  clicksDirections Int         @default(0)
  messages         Int         @default(0)
  bookings         Int         @default(0)
  createdAt        DateTime    @default(now())

  @@unique([locationId, date])
  @@index([locationId])
  @@index([date])
}

model ContentItem {
  id            Int             @id @default(autoincrement())
  propertyId    Int
  property      WebsiteProperty @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  title         String
  targetKeyword String
  searchIntent  String?
  contentType   String?         // Blog, Landing Page, Guide, etc.
  priority      String          @default("MEDIUM") // LOW, MEDIUM, HIGH
  source        String          @default("MANUAL") // GSC, RANKINGS, ONPAGE, MANUAL
  status        String          @default("IDEA") // IDEA, RESEARCH, BRIEF, PLANNED, DRAFTING, IN_REVIEW, APPROVED, SCHEDULED, PUBLISHED
  publishDate   DateTime?
  liveUrl       String?
  pubNotes      String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  brief         ContentBrief?
  draft         ContentDraft?

  @@index([propertyId])
  @@index([status])
}

model ContentBrief {
  id               Int         @id @default(autoincrement())
  contentItemId    Int         @unique
  contentItem      ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  primaryKeywords  String?
  secondaryKeywords String?
  targetAudience   String?
  suggestedUrl     String?
  seoTitle         String?
  metaDescription  String?
  wordCountTarget  Int?
  outline          String?     // Markdown Outline
  internalLinking  String?
  writerNotes      String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model ContentDraft {
  id            Int         @id @default(autoincrement())
  contentItemId Int         @unique
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  body          String?     // HTML or markdown editor body
  reviewNotes   String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
